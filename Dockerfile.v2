FROM node:24.13.0-bookworm-slim@sha256:4660b1ca8b28d6d1906fd644abe34b2ed81d15434d26d845ef0aced307cf4b6f AS web-builder

WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.26-bookworm@sha256:6c5605ab3a9a9fb3c4eafe5b3d63cdbf3881caf113262b67862547b54a9db599 AS go-builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILT_AT=unknown

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
COPY migrations/ migrations/
COPY --from=web-builder /src/internal/webui/dist/ internal/webui/dist/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w -X github.com/loofk/upload-assistant/v2/internal/buildinfo.version=${VERSION:-dev} -X github.com/loofk/upload-assistant/v2/internal/buildinfo.commit=${COMMIT:-unknown} -X github.com/loofk/upload-assistant/v2/internal/buildinfo.builtAt=${BUILT_AT:-unknown}" \
    -o /out/upload-assistant ./cmd/upload-assistant

FROM ghcr.io/autobrr/mkbrr:v1.23.0@sha256:41cbe35d5d2faf09efb5e3ec3846b258b13f68851baaf0ae8465176f627bf1b6 AS mkbrr

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    mediainfo \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 upload-assistant \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin upload-assistant \
    && mkdir -p /data/artifacts /data/rules /data/tmp /downloads \
    && chown -R upload-assistant:upload-assistant /data /downloads

COPY --from=go-builder /out/upload-assistant /usr/local/bin/upload-assistant
COPY --from=mkbrr /usr/local/bin/mkbrr /usr/local/bin/mkbrr

USER 1000:1000
EXPOSE 8080
VOLUME ["/data", "/downloads"]

ENTRYPOINT ["/usr/local/bin/upload-assistant"]
CMD ["serve"]
