{
  "openapi": "3.1.0",
  "info": {
    "title": "Upload Assistant API",
    "version": "2.0.0-dev",
    "description": "Local-first Chinese PT retorrent automation with durable steps, rule gates, and auditable evidence."
  },
  "servers": [{"url": "http://127.0.0.1:8080"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenAPIDocument",
        "security": [],
        "responses": {"200": {"description": "OpenAPI document"}}
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "security": [],
        "responses": {"200": {"description": "Process is alive", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": {"description": "Service is ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}},
          "503": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/api/v2/version": {
      "get": {
        "operationId": "getVersion",
        "security": [],
        "responses": {"200": {"description": "Build information", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    },
    "/api/v2/tools": {
      "get": {
        "operationId": "listAITools",
        "responses": {"200": {"description": "Compact AI tool definitions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolsResponse"}}}}, "401": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/jobs": {
      "post": {
        "operationId": "createRetorrentJob",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateJobRequest"}}}},
        "responses": {
          "202": {"description": "Durable job accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEnvelope"}}}},
          "400": {"$ref": "#/components/responses/Problem"},
          "401": {"$ref": "#/components/responses/Problem"},
          "409": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/api/v2/jobs/{job_id}": {
      "get": {
        "operationId": "getJobStatus",
        "parameters": [{"$ref": "#/components/parameters/JobID"}],
        "responses": {"200": {"description": "Job status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEnvelope"}}}}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/jobs/{job_id}/summary": {
      "get": {
        "operationId": "getJobSummary",
        "parameters": [{"$ref": "#/components/parameters/JobID"}],
        "responses": {"200": {"description": "Job summary and evidence", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobSummaryEnvelope"}}}}, "404": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/jobs/{job_id}/steps": {
      "get": {
        "operationId": "listJobSteps",
        "parameters": [{"$ref": "#/components/parameters/JobID"}],
        "responses": {"200": {"description": "Durable workflow steps", "content": {"application/json": {"schema": {"type": "object", "required": ["ok", "status", "job_id", "steps"], "properties": {"ok": {"type": "boolean"}, "status": {"$ref": "#/components/schemas/JobStatus"}, "job_id": {"type": "string", "format": "uuid"}, "current_step": {"type": "string"}, "blockers": {"type": "array", "items": {"$ref": "#/components/schemas/Blocker"}}, "next_actions": {"type": "array", "items": {"$ref": "#/components/schemas/NextAction"}}, "steps": {"type": "array", "items": {"$ref": "#/components/schemas/Step"}}}}}}}}
      }
    },
    "/api/v2/jobs/{job_id}/events": {
      "get": {
        "operationId": "listJobEvents",
        "parameters": [
          {"$ref": "#/components/parameters/JobID"},
          {"name": "after", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}
        ],
        "responses": {"200": {"description": "Hash-chained audit events", "content": {"application/json": {"schema": {"type": "object", "required": ["ok", "status", "job_id", "events", "next_cursor"], "properties": {"ok": {"type": "boolean"}, "status": {"type": "string"}, "job_id": {"type": "string", "format": "uuid"}, "events": {"type": "array", "items": {"$ref": "#/components/schemas/Event"}}, "next_cursor": {"type": "integer"}}}}}}}
      }
    },
    "/api/v2/jobs/{job_id}/artifacts": {
      "get": {
        "operationId": "listJobArtifacts",
        "parameters": [{"$ref": "#/components/parameters/JobID"}],
        "responses": {"200": {"description": "Artifact evidence", "content": {"application/json": {"schema": {"type": "object", "required": ["ok", "status", "job_id", "artifacts"], "properties": {"ok": {"type": "boolean"}, "status": {"$ref": "#/components/schemas/JobStatus"}, "job_id": {"type": "string", "format": "uuid"}, "artifacts": {"type": "array", "items": {"$ref": "#/components/schemas/Artifact"}}, "blockers": {"type": "array", "items": {"$ref": "#/components/schemas/Blocker"}}, "next_actions": {"type": "array", "items": {"$ref": "#/components/schemas/NextAction"}}}}}}}}
      }
    },
    "/api/v2/jobs/{job_id}/pause": {
      "post": {"operationId": "pauseJob", "parameters": [{"$ref": "#/components/parameters/JobID"}], "responses": {"200": {"description": "Job paused", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEnvelope"}}}}, "409": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/jobs/{job_id}/resume": {
      "post": {
        "operationId": "resumeJob",
        "parameters": [{"$ref": "#/components/parameters/JobID"}],
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResumeJobRequest"}}}},
        "responses": {"200": {"description": "Job queued for recovery", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEnvelope"}}}}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/jobs/{job_id}/cancel": {
      "post": {"operationId": "cancelJob", "parameters": [{"$ref": "#/components/parameters/JobID"}], "responses": {"200": {"description": "Job cancelled", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEnvelope"}}}}, "409": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/sites": {
      "get": {"operationId": "listSites", "responses": {"200": {"description": "Site adapters and active rule fingerprints", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/v2/sites/{site_code}/rules": {
      "get": {"operationId": "listSiteRuleRevisions", "parameters": [{"$ref": "#/components/parameters/SiteCode"}], "responses": {"200": {"description": "Rule revision history", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/v2/sites/{site_code}/rules/active": {
      "get": {"operationId": "getActiveSiteRules", "parameters": [{"$ref": "#/components/parameters/SiteCode"}], "responses": {"200": {"description": "Active approved rule revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleEnvelope"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/site-rules/import": {
      "post": {
        "operationId": "importSiteRuleRevision",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["markdown"], "properties": {"markdown": {"type": "string", "minLength": 1}}}}}},
        "responses": {"201": {"description": "Immutable draft imported", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleEnvelope"}}}}, "400": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/site-rules/{revision_id}": {
      "get": {"operationId": "getSiteRuleRevision", "parameters": [{"$ref": "#/components/parameters/RevisionID"}], "responses": {"200": {"description": "Rule revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleEnvelope"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/site-rules/{revision_id}/markdown": {
      "get": {"operationId": "getSiteRuleMarkdown", "parameters": [{"$ref": "#/components/parameters/RevisionID"}], "responses": {"200": {"description": "Checksum-verified Markdown", "content": {"text/markdown": {"schema": {"type": "string"}}}}}}
    },
    "/api/v2/site-rules/{revision_id}/approve": {
      "post": {
        "operationId": "approveSiteRuleRevision",
        "parameters": [{"$ref": "#/components/parameters/RevisionID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["fingerprint"], "properties": {"fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "comment": {"type": "string"}}}}}},
        "responses": {"200": {"description": "Rule revision approved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleEnvelope"}}}}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/site-rules/{revision_id}/activate": {
      "post": {"operationId": "activateSiteRuleRevision", "parameters": [{"$ref": "#/components/parameters/RevisionID"}], "responses": {"200": {"description": "Approved revision activated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleEnvelope"}}}}, "409": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/sites/{site_code}/credentials": {
      "get": {"operationId": "listSiteCredentials", "parameters": [{"$ref": "#/components/parameters/SiteCode"}], "responses": {"200": {"description": "Credential metadata without secret values", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/v2/sites/{site_code}/credentials/{credential_name}": {
      "put": {
        "operationId": "putSiteCredential",
        "parameters": [{"$ref": "#/components/parameters/SiteCode"}, {"$ref": "#/components/parameters/CredentialName"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["value"], "properties": {"value": {"type": "string", "minLength": 1, "writeOnly": true}}}}}},
        "responses": {"200": {"description": "Credential encrypted and configured", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/sites/{site_code}/credentials/{credential_name}/disable": {
      "post": {"operationId": "disableSiteCredential", "parameters": [{"$ref": "#/components/parameters/SiteCode"}, {"$ref": "#/components/parameters/CredentialName"}], "responses": {"200": {"description": "Credential disabled without deleting encrypted history", "content": {"application/json": {"schema": {"type": "object"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/downloaders": {
      "get": {"operationId": "listDownloaders", "responses": {"200": {"description": "Remote downloaders with redacted credential metadata", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/v2/downloaders/{name}": {
      "put": {
        "operationId": "putDownloader",
        "parameters": [{"$ref": "#/components/parameters/ResourceName"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DownloaderInput"}}}},
        "responses": {"200": {"description": "Downloader configured", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/downloaders/{name}/probe": {
      "post": {"operationId": "probeDownloader", "parameters": [{"$ref": "#/components/parameters/ResourceName"}], "responses": {"200": {"description": "Authenticated downloader version probe", "content": {"application/json": {"schema": {"type": "object"}}}}, "502": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/downloaders/{name}/torrents": {
      "post": {"operationId": "addDownloaderTorrent", "parameters": [{"$ref": "#/components/parameters/ResourceName"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AddTorrentRequest"}}}}, "responses": {"200": {"description": "Torrent added with hash evidence", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "502": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/downloaders/{name}/torrents/{hash}": {
      "get": {"operationId": "inspectDownloaderTorrent", "parameters": [{"$ref": "#/components/parameters/ResourceName"}, {"$ref": "#/components/parameters/TorrentHash"}], "responses": {"200": {"description": "Torrent state and mapped path evidence", "content": {"application/json": {"schema": {"type": "object"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/downloaders/{name}/torrents/{hash}/limits": {
      "post": {"operationId": "setDownloaderTorrentLimits", "parameters": [{"$ref": "#/components/parameters/ResourceName"}, {"$ref": "#/components/parameters/TorrentHash"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SetTorrentLimitsRequest"}}}}, "responses": {"200": {"description": "Per-torrent limits applied and observed", "content": {"application/json": {"schema": {"type": "object"}}}}, "502": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v2/image-hosts": {
      "get": {"operationId": "listImageHosts", "responses": {"200": {"description": "Image hosts ordered by priority", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/v2/image-hosts/{name}": {
      "put": {
        "operationId": "putImageHost",
        "parameters": [{"$ref": "#/components/parameters/ResourceName"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImageHostInput"}}}},
        "responses": {"200": {"description": "Image host configured", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v2/screenshot-profiles": {
      "get": {"operationId": "listScreenshotProfiles", "responses": {"200": {"description": "Immutable screenshot profile revisions", "content": {"application/json": {"schema": {"type": "object"}}}}}},
      "post": {"operationId": "createScreenshotProfile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ScreenshotProfileInput"}}}}, "responses": {"201": {"description": "New screenshot profile revision created", "content": {"application/json": {"schema": {"type": "object"}}}}, "400": {"$ref": "#/components/responses/Problem"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "ua_API_token"}
    },
    "parameters": {
      "JobID": {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "RevisionID": {"name": "revision_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "SiteCode": {"name": "site_code", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Z0-9_-]+$"}},
      "ResourceName": {"name": "name", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
      "CredentialName": {"name": "credential_name", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}},
      "TorrentHash": {"name": "hash", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-fA-F0-9]{40}([a-fA-F0-9]{24})?$"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 200}}
    },
    "responses": {
      "Problem": {"description": "Structured API problem", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["ok", "status", "service", "version"],
        "properties": {"ok": {"type": "boolean"}, "status": {"type": "string"}, "service": {"type": "string"}, "version": {"type": "string"}, "checks": {"type": "object", "additionalProperties": {"type": "string"}}}
      },
      "JobStatus": {"type": "string", "enum": ["draft", "queued", "running", "paused", "blocked", "failed", "complete", "cancelled"]},
      "StepStatus": {"type": "string", "enum": ["pending", "ready", "running", "paused", "blocked", "failed", "complete", "skipped", "cancelled"]},
      "Blocker": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "site_code": {"type": "string"}, "obligation_id": {"type": "string"}},
        "additionalProperties": true
      },
      "NextAction": {
        "type": "object",
        "required": ["action"],
        "properties": {"action": {"type": "string"}, "description": {"type": "string"}, "parameters": {"type": "object", "additionalProperties": true}},
        "additionalProperties": true
      },
      "ObligationAcceptance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["confirmed", "evidence"],
        "properties": {"confirmed": {"type": "boolean"}, "evidence": {"type": "string", "description": "Non-empty per-job human evidence is required for blocking manual obligations."}}
      },
      "RuleAcceptance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted", "fingerprint"],
        "properties": {
          "accepted": {"type": "boolean", "const": true},
          "fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "obligations": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/ObligationAcceptance"}}
        }
      },
      "RetorrentInput": {
        "type": "object",
        "required": ["source_url", "target"],
        "properties": {
          "source_url": {"type": "string", "format": "uri"},
          "target": {"type": "string", "description": "Uppercase target tracker code."},
          "accept_rules": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/RuleAcceptance"}}
        },
        "additionalProperties": true
      },
      "CreateJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input"],
        "properties": {"kind": {"type": "string", "const": "retorrent", "default": "retorrent"}, "execution_mode": {"type": "string", "enum": ["auto", "step"], "default": "auto"}, "stop_after_step": {"type": "string"}, "input": {"$ref": "#/components/schemas/RetorrentInput"}}
      },
      "ResumeJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"resume_state": {"type": "object", "additionalProperties": true, "default": {}}}
      },
      "Job": {
        "type": "object",
        "required": ["id", "kind", "status", "execution_mode", "input", "blockers", "next_actions", "resume_state", "summary", "created_at", "updated_at"],
        "properties": {
          "id": {"type": "string", "format": "uuid"}, "kind": {"type": "string"}, "status": {"$ref": "#/components/schemas/JobStatus"}, "execution_mode": {"type": "string", "enum": ["auto", "step"]}, "current_step": {"type": "string"},
          "input": {"type": "object"}, "blockers": {"type": "array", "items": {"$ref": "#/components/schemas/Blocker"}}, "next_actions": {"type": "array", "items": {"$ref": "#/components/schemas/NextAction"}}, "resume_state": {"type": "object"}, "summary": {"type": "object"},
          "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}
        }
      },
      "JobEnvelope": {
        "type": "object",
        "required": ["ok", "status", "job_id", "blockers", "next_actions", "resume_state", "summary", "job"],
        "properties": {"ok": {"type": "boolean"}, "status": {"$ref": "#/components/schemas/JobStatus"}, "job_id": {"type": "string", "format": "uuid"}, "current_step": {"type": "string"}, "blockers": {"type": "array", "items": {"$ref": "#/components/schemas/Blocker"}}, "next_actions": {"type": "array", "items": {"$ref": "#/components/schemas/NextAction"}}, "resume_state": {"type": "object"}, "summary": {"type": "object"}, "job": {"$ref": "#/components/schemas/Job"}}
      },
      "JobSummaryEnvelope": {
        "type": "object",
        "required": ["ok", "status", "job_id", "blockers", "next_actions", "resume_state", "summary", "steps", "artifacts"],
        "properties": {"ok": {"type": "boolean"}, "status": {"$ref": "#/components/schemas/JobStatus"}, "job_id": {"type": "string", "format": "uuid"}, "current_step": {"type": "string"}, "blockers": {"type": "array", "items": {"$ref": "#/components/schemas/Blocker"}}, "next_actions": {"type": "array", "items": {"$ref": "#/components/schemas/NextAction"}}, "resume_state": {"type": "object"}, "summary": {"type": "object"}, "steps": {"type": "array", "items": {"$ref": "#/components/schemas/Step"}}, "artifacts": {"type": "array", "items": {"$ref": "#/components/schemas/Artifact"}}}
      },
      "Step": {"type": "object", "required": ["id", "job_id", "key", "position", "status", "required", "input_snapshot", "output_summary", "blockers", "next_actions", "resume_state"], "properties": {"id": {"type": "string", "format": "uuid"}, "job_id": {"type": "string", "format": "uuid"}, "key": {"type": "string"}, "position": {"type": "integer"}, "status": {"$ref": "#/components/schemas/StepStatus"}, "required": {"type": "boolean"}, "gate_kind": {"type": "string"}, "input_snapshot": {"type": "object"}, "output_summary": {"type": "object"}, "blockers": {"type": "array", "items": {"$ref": "#/components/schemas/Blocker"}}, "next_actions": {"type": "array", "items": {"$ref": "#/components/schemas/NextAction"}}, "resume_state": {"type": "object"}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}}},
      "Event": {"type": "object", "required": ["id", "job_id", "sequence", "type", "actor_type", "payload", "hash", "created_at"], "properties": {"id": {"type": "string", "format": "uuid"}, "job_id": {"type": "string", "format": "uuid"}, "step_id": {"type": "string", "format": "uuid"}, "attempt_id": {"type": "string", "format": "uuid"}, "sequence": {"type": "integer"}, "type": {"type": "string"}, "actor_type": {"type": "string"}, "actor_id": {"type": "string"}, "payload": {"type": "object"}, "previous_hash": {"type": "string"}, "hash": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}}},
      "Artifact": {"type": "object", "required": ["id", "job_id", "kind", "storage_backend", "storage_path", "filename", "size_bytes", "sha256", "metadata", "expires_at", "created_at"], "properties": {"id": {"type": "string", "format": "uuid"}, "job_id": {"type": "string", "format": "uuid"}, "step_id": {"type": "string", "format": "uuid"}, "attempt_id": {"type": "string", "format": "uuid"}, "kind": {"type": "string"}, "storage_backend": {"type": "string"}, "storage_path": {"type": "string"}, "filename": {"type": "string"}, "mime_type": {"type": "string"}, "size_bytes": {"type": "integer"}, "sha256": {"type": "string"}, "metadata": {"type": "object"}, "expires_at": {"type": "string", "format": "date-time"}, "created_at": {"type": "string", "format": "date-time"}}},
      "EndpointConfig": {"type": "object", "additionalProperties": false, "required": ["endpoint"], "properties": {"endpoint": {"type": "string", "format": "uri"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 30}, "options": {"type": "object", "description": "Non-secret adapter options only.", "additionalProperties": true}}},
      "PathMapping": {"type": "object", "additionalProperties": false, "required": ["remote_path", "local_path"], "properties": {"remote_path": {"type": "string", "pattern": "^/"}, "local_path": {"type": "string", "pattern": "^/"}, "priority": {"type": "integer"}}},
      "DownloaderInput": {"type": "object", "additionalProperties": false, "required": ["adapter", "config"], "properties": {"adapter": {"type": "string", "enum": ["qbittorrent", "rtorrent", "deluge", "transmission"]}, "enabled": {"type": "boolean", "default": true}, "config": {"$ref": "#/components/schemas/EndpointConfig"}, "credentials": {"type": "object", "description": "Encrypted at rest and never returned.", "additionalProperties": {"type": "string", "writeOnly": true}}, "path_mappings": {"type": "array", "items": {"$ref": "#/components/schemas/PathMapping"}}}},
