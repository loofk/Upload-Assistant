{
  "schema_version": "ptcli.agent_manifest.v1",
  "name": "ptcli-retorrent",
  "display_name": "PTCLI Retorrent Assistant",
  "description": "AI-callable Chinese PT retorrent, upload, qBittorrent, and daily-candidate automation service.",
  "audience": [
    "Hermes",
    "OpenAPI-compatible agents"
  ],
  "base_url": "http://127.0.0.1:8080",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "format": "Bearer <PTCLI_API_TOKEN>",
    "env": "PTCLI_API_TOKEN"
  },
  "discovery": {
    "health": "http://127.0.0.1:8080/health",
    "deployment_check": "http://127.0.0.1:8080/v1/deployment/check",
    "openapi": "http://127.0.0.1:8080/openapi.json",
    "tools": "http://127.0.0.1:8080/v1/tools",
    "manifest": "http://127.0.0.1:8080/.well-known/ptcli-agent.json"
  },
  "safety": {
    "live_upload_requires": [
      "accept_rules=true",
      "confirm_upload=true"
    ],
    "never_skip": [
      "site rule gates",
      "target duplicate check",
      "uploaded torrent injection/seeding evidence"
    ],
    "blocked_contract": "When rules, duplicate checks, qBittorrent evidence, or required confirmations are missing, APIs return status=blocked with blockers and next_actions."
  },
  "workflows": [
    {
      "name": "source_url_retorrent",
      "tool": "source_url_retorrent_job",
      "required_fields": [
        "source_url",
        "target"
      ],
      "poll": "get_job_status",
      "resume": "resume_job"
    },
    {
      "name": "manual_retorrent",
      "tool": "manual_retorrent_job",
      "required_fields": [
        "source",
        "target"
      ],
      "poll": "get_job_status",
      "resume": "resume_job"
    },
    {
      "name": "daily_candidates",
      "tool": "daily_candidates_job",
      "required_fields": [
        "source_tracker",
        "target"
      ],
      "read_result": [
        "digest",
        "candidates",
        "ready_count"
      ],
      "poll": "get_job_status"
    }
  ],
  "tools": [
    {
      "name": "deployment_check",
      "method": "GET",
      "path": "/v1/deployment/check",
      "description": "Check local ptcli deployment readiness: runtime imports, config mount, cookies/tmp/job/download paths, API token warning, and qBittorrent config presence. This does not contact trackers or qBittorrent.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "config": {
            "type": "string"
          },
          "base_dir": {
            "type": "string"
          },
          "cookies_dir": {
            "type": "string"
          },
          "job_dir": {
            "type": "string"
          },
          "downloads_path": {
            "type": "string"
          },
          "compose_file": {
            "type": "string"
          },
          "client": {
            "type": "string",
            "default": "default"
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "ready",
          "checks",
          "blockers",
          "warnings",
          "next_actions",
          "paths",
          "mounts",
          "qbit",
          "daily_candidates",
          "docker_compose",
          "agent_summary"
        ],
        "agent_summary_fields": [
          "ready_for_ai",
          "ready_for_manual_retorrent",
          "ready_for_daily_candidates",
          "missing_mounts",
          "qbit_configured",
          "daily_candidates_configured",
          "docker_compose_daily_ready"
        ]
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "site_policies",
      "method": "POST",
      "path": "/v1/site-policies",
      "description": "Return the configured Chinese PT site policy matrix: automation gates, qBittorrent rate limits, seeding requirements, rule URLs, and manual review blockers. This does not contact trackers.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "trackers": {
            "type": [
              "string",
              "array"
            ]
          },
          "source_tracker": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "array"
            ]
          },
          "accept_rules": {
            "type": "boolean"
          },
          "config": {
            "type": "string"
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "ready",
          "policy_matrix",
          "qbit_limits",
          "policy_gap_summary",
          "blockers",
          "next_actions",
          "agent_summary"
        ],
        "policy_fields": [
          "tracker",
          "roles",
          "rules_url",
          "automation",
          "qbit_limits",
          "seeding_requirements",
          "manual_review_required",
          "rule_review_fingerprint",
          "policy_coverage"
        ],
        "gap_summary_fields": [
          "ready",
          "missing_total",
          "disabled_total",
          "by_role",
          "missing_by_category",
          "recommendations"
        ]
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "retorrent_job",
      "method": "POST",
      "path": "/v1/jobs/retorrent",
      "input_schema": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Source tracker details URL or torrent id."
          },
          "source_tracker": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "array"
            ]
          },
          "execute": {
            "type": "boolean"
          },
          "accept_rules": {
            "type": "boolean"
          },
          "confirm_upload": {
            "type": "boolean"
          },
          "save_path": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "uploaded_qbit_category": {
            "type": "string"
          },
          "uploaded_qbit_tags": {
            "type": "string"
          },
          "uploaded_qbit_upload_limit": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Optional uploaded target torrent upload limit. If omitted, PTCLI.SITE_POLICIES may provide a default."
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "summary_file",
          "resume_state",
          "agent_summary",
          "agent_decision",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "runtime",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ],
        "status_values": [
          "queued",
          "running",
          "blocked",
          "failed",
          "complete"
        ]
      },
      "safety": {
        "live_upload": true,
        "requires_confirmation": [
          "accept_rules=true",
          "confirm_upload=true"
        ]
      }
    },
    {
      "name": "manual_retorrent_job",
      "method": "POST",
      "path": "/v1/jobs/retorrent/submit",
      "description": "Submit the primary source URL plus target tracker job. It checks duplicates and only proceeds when rule, duplicate, and confirmation gates allow.",
      "input_schema": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "source_tracker": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "array"
            ]
          },
          "accept_rules": {
            "type": "boolean"
          },
          "confirm_upload": {
            "type": "boolean"
          },
          "save_path": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "uploaded_qbit_category": {
            "type": "string"
          },
          "uploaded_qbit_tags": {
            "type": "string"
          },
          "execute_if_no_duplicate": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "summary_file",
          "resume_state",
          "agent_summary",
          "agent_decision",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "runtime",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ]
      },
      "safety": {
        "live_upload": true,
        "requires_confirmation": [
          "accept_rules=true",
          "confirm_upload=true"
        ]
      }
    },
    {
      "name": "source_url_retorrent_job",
      "method": "POST",
      "path": "/v1/jobs/retorrent/from-url",
      "description": "Recommended AI entrypoint for a user-provided source tracker details URL plus target tracker. It infers the source tracker and torrent id, checks duplicates, and only proceeds when rule, duplicate, and confirmation gates allow.",
      "input_schema": {
        "type": "object",
        "required": [
          "source_url",
          "target"
        ],
        "properties": {
          "source_url": {
            "type": "string",
            "description": "User-provided source tracker details or download URL."
          },
          "source": {
            "type": "string",
            "description": "Alias for source_url."
          },
          "source_tracker": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "array"
            ]
          },
          "accept_rules": {
            "type": "boolean"
          },
          "confirm_upload": {
            "type": "boolean"
          },
          "save_path": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "uploaded_qbit_category": {
            "type": "string"
          },
          "uploaded_qbit_tags": {
            "type": "string"
          },
          "execute_if_no_duplicate": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "summary_file",
          "resume_state",
          "agent_summary",
          "agent_decision",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ]
      },
      "safety": {
        "live_upload": true,
        "requires_confirmation": [
          "accept_rules=true",
          "confirm_upload=true"
        ]
      }
    },
    {
      "name": "daily_candidates_job",
      "method": "POST",
      "path": "/v1/jobs/candidates/daily",
      "description": "Create an asynchronous ranked daily-candidate discovery job and return a job_id for polling.",
      "input_schema": {
        "type": "object",
        "required": [
          "source_tracker",
          "target"
        ],
        "properties": {
          "source_tracker": {
            "type": "string"
          },
          "target": {
            "type": [
              "string",
              "array"
            ]
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "maximum": 10
          },
          "accept_rules": {
            "type": "boolean"
          },
          "check_dupes": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ],
        "result_fields": [
          "ranking",
          "digest",
          "candidates",
          "ready_count"
        ],
        "digest_fields": [
          "recommendation",
          "top_candidate",
          "top_submit_request",
          "top_submit_job_endpoint",
          "top_submit_tool",
          "push_items",
          "blockers",
          "next_actions"
        ],
        "candidate_fields": [
          "ranking",
          "recommendation",
          "duplicate_check",
          "blockers",
          "policy_summary",
          "policy_coverage",
          "agent_workflow",
          "submit_request",
          "submit_job_endpoint",
          "submit_tool",
          "execute_request"
        ]
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "daily_candidates_schedule",
      "method": "POST",
      "path": "/v1/candidates/daily/schedule",
      "description": "Validate and normalize daily candidate schedules into job requests that external cron, Docker, OpenClaw, or Hermes can run. This endpoint does not contact trackers or upload.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_tracker",
                "target"
              ],
              "properties": {
                "source_tracker": {
                  "type": "string"
                },
                "target": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "default": 10,
                  "maximum": 10
                },
                "accept_rules": {
                  "type": "boolean"
                },
                "check_dupes": {
                  "type": "boolean",
                  "default": true
                },
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "time": {
                  "type": "string",
                  "default": "09:00"
                },
                "timezone": {
                  "type": "string",
                  "default": "Asia/Shanghai"
                }
              }
            }
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "count",
          "schedules",
          "blockers",
          "next_actions"
        ],
        "schedule_fields": [
          "name",
          "enabled",
          "schedule",
          "job_endpoint",
          "job_request",
          "push_contract"
        ]
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "daily_candidates_schedule_job",
      "method": "POST",
      "path": "/v1/jobs/candidates/daily/schedule",
      "description": "Create one daily-candidate discovery job per enabled schedule entry and return job_ids for polling. This only scans candidates and never uploads.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_tracker",
                "target"
              ],
              "properties": {
                "source_tracker": {
                  "type": "string"
                },
                "target": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "default": 10,
                  "maximum": 10
                },
                "accept_rules": {
                  "type": "boolean"
                },
                "check_dupes": {
                  "type": "boolean",
                  "default": true
                },
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "time": {
                  "type": "string",
                  "default": "09:00"
                },
                "timezone": {
                  "type": "string",
                  "default": "Asia/Shanghai"
                }
              }
            }
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_count",
          "jobs",
          "skipped",
          "schedule_digest",
          "agent_decision",
          "blockers",
          "next_actions"
        ],
        "job_fields": [
          "schedule_name",
          "job_id",
          "status_endpoint",
          "summary_endpoint",
          "job_request",
          "candidate_digest",
          "agent_decision"
        ],
        "digest_fields": [
          "items",
          "push_items",
          "top_submit_requests",
          "ready_job_count",
          "submit_request_count",
          "pending_job_count",
          "blocked_job_count"
        ]
      },
      "workflow_hints": {
        "poll_with": "get_job_status",
        "summary_with": "get_job_summary"
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "list_jobs",
      "method": "GET",
      "path": "/v1/jobs",
      "description": "List recent ptcli jobs with short AI-readable status, blockers, resume plan, lineage, and status/summary/resume endpoints. This endpoint never runs work.",
      "input_schema": {
        "type": "object",
        "required": [],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "blocked",
              "failed",
              "complete",
              "cancelled"
            ]
          },
          "kind": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "count",
          "total",
          "limit",
          "filters",
          "status_counts",
          "jobs",
          "next_actions"
        ],
        "job_fields": [
          "job_id",
          "kind",
          "status",
          "blockers",
          "next_actions",
          "interruption",
          "cancellation",
          "runtime",
          "summary_file",
          "source_reference",
          "duplicate_check",
          "agent_decision",
          "resume_plan",
          "resume_lineage",
          "status_endpoint",
          "summary_endpoint",
          "resume_endpoint"
        ],
        "filters": [
          "status",
          "kind",
          "limit"
        ]
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "get_job_status",
      "method": "GET",
      "path": "/v1/jobs/{job_id}",
      "input_schema": {
        "type": "object",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "interruption",
          "cancellation",
          "runtime",
          "summary_file",
          "resume_state",
          "agent_summary",
          "agent_decision",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ]
      },
      "safety": {
        "live_upload": false
      }
    },
    {
      "name": "resume_job",
      "method": "POST",
      "path": "/v1/jobs/{job_id}/resume",
      "input_schema": {
        "type": "object",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ]
      },
      "safety": {
        "live_upload": "inherits_from_resume_command",
        "requires_confirmation": [
          "existing allowlisted next_command_argv"
        ]
      }
    },
    {
      "name": "cancel_job",
      "method": "POST",
      "path": "/v1/jobs/{job_id}/cancel",
      "description": "Cancel a queued job before it starts. Running jobs are not force-stopped and return 409 so live tracker/qBittorrent work is not interrupted unsafely.",
      "input_schema": {
        "type": "object",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "blockers",
          "next_actions",
          "interruption",
          "cancellation",
          "runtime",
          "summary_file",
          "resume_state",
          "agent_summary",
          "agent_decision",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context"
        ],
        "status_values": [
          "queued",
          "running",
          "blocked",
          "failed",
          "complete",
          "cancelled"
        ]
      },
      "safety": {
        "live_upload": false,
        "requires_confirmation": [
          "job must still be queued"
        ]
      }
    },
    {
      "name": "get_job_summary",
      "method": "GET",
      "path": "/v1/jobs/{job_id}/summary",
      "description": "Return the parsed job summary file, full result, agent decision, resume plan, policy coverage, source reference, and workflow context.",
      "input_schema": {
        "type": "object",
        "required": [
          "job_id"
        ],
        "properties": {
          "job_id": {
            "type": "string"
          }
        }
      },
      "response_contract": {
        "required_fields": [
          "status",
          "ok",
          "job_id",
          "summary_file",
          "summary",
          "agent_summary",
          "agent_decision",
          "candidate_digest",
          "policy_coverage",
          "policy_qbit_defaults",
          "runtime",
          "resume_plan",
          "resume_lineage",
          "resume_context",
          "source_reference",
          "workflow_context",
          "result",
          "blockers",
          "next_actions"
        ]
      },
      "safety": {
        "live_upload": false
      }
    }
  ]
}
