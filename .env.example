# Copy this file to .env, then set a unique random hexadecimal password.
# Generate one with: openssl rand -hex 32
UA_POSTGRES_PASSWORD=

# Optional deployment overrides.
UA_POSTGRES_DB=upload_assistant
UA_POSTGRES_USER=upload_assistant
UA_HTTP_PORT=8080
UA_IMAGE=ghcr.io/loofk/upload-assistant:latest
UA_LOG_LEVEL=info
TZ=Asia/Shanghai

# Each source may be either a named Docker volume or an absolute host path.
UA_POSTGRES_DATA_SOURCE=ua-postgres
UA_DATA_SOURCE=ua-data
UA_BACKUPS_SOURCE=ua-backups
UA_DOWNLOADS_HOST_PATH=./tmp/downloads
UA_LEGACY_DATA_HOST_PATH=./data

# Attach an existing qBittorrent container to this network, or configure its
# endpoint as http://host.docker.internal:<port> when it runs on the host.
UA_DOCKER_NETWORK=upload-assistant-v2
