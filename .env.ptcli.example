# Copy this file to .env before running docker compose.
# Keep the API bound to 127.0.0.1 unless you also set PTCLI_API_TOKEN.

TZ=Asia/Shanghai

# Recommended when the API is reachable outside localhost.
PTCLI_API_TOKEN=change-me
PTCLI_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Job queue and runtime paths inside the ptcli container.
PTCLI_MAX_CONCURRENT_JOBS=1
PTCLI_JOB_DIR=/Upload-Assistant/tmp/ptcli-jobs
PTCLI_DOWNLOADS_PATH=/downloads

# Host-side paths used by docker-compose.yml volume mounts.
# Keep PTCLI_DOWNLOADS_HOST_PATH aligned with the qBittorrent save path mapping.
PTCLI_DOWNLOADS_HOST_PATH=/path/to/torrents/
PTCLI_CONFIG_HOST_PATH=/mnt/user/appdata/Upload-Assistant/data/config.py
PTCLI_COOKIES_HOST_PATH=/mnt/user/appdata/Upload-Assistant/data/cookies/
PTCLI_TMP_HOST_PATH=/mnt/user/appdata/Upload-Assistant/tmp/

# Optional daily candidate schedules. Keep confirm_upload=false here; submit individual candidates only after review.
# JSON example:
# [{"name":"u2-to-mteam-daily","source_tracker":"U2","target":"MTEAM","limit":10,"time":"09:00","timezone":"Asia/Shanghai","accept_rules":true,"confirm_upload":false}]
PTCLI_DAILY_CANDIDATE_SCHEDULES=
PTCLI_DAILY_CANDIDATE_OUTPUT_DIR=/Upload-Assistant/tmp/daily-candidates
PTCLI_DAILY_CANDIDATE_WEBHOOK_URL=

# Optional Docker network name shared with qBittorrent or reverse proxy containers.
PTCLI_DOCKER_NETWORK=upload-assistant-ptcli
