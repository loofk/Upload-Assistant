FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TMPDIR=/Upload-Assistant/tmp

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    mediainfo && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* && \
    update-ca-certificates

WORKDIR /Upload-Assistant

COPY requirements-ptcli.txt .
RUN python -m pip install --upgrade pip==25.3 wheel==0.45.1 && \
    pip install --no-cache-dir -r requirements-ptcli.txt

RUN mkdir -p data
COPY ptcli.py .
COPY src/__init__.py src/__init__.py
COPY src/ptcli/ src/ptcli/
COPY src/trackers/__init__.py src/trackers/__init__.py
COPY src/trackers/AUDIENCES.py src/trackers/AUDIENCES.py
COPY src/trackers/CHD.py src/trackers/CHD.py
COPY src/trackers/COMMON.py src/trackers/COMMON.py
COPY src/trackers/HDSKY.py src/trackers/HDSKY.py
COPY src/trackers/HHAN.py src/trackers/HHAN.py
COPY src/trackers/MTEAM.py src/trackers/MTEAM.py
COPY src/trackers/OB.py src/trackers/OB.py
COPY src/trackers/PTER.py src/trackers/PTER.py
COPY src/trackers/TJUPT.py src/trackers/TJUPT.py
COPY src/trackers/TTG.py src/trackers/TTG.py
COPY src/trackers/U2.py src/trackers/U2.py
COPY src/bbcode.py src/bbcode.py
COPY src/cleanup.py src/cleanup.py
COPY src/console.py src/console.py
COPY src/cookie_auth.py src/cookie_auth.py
COPY src/exceptions.py src/exceptions.py
COPY src/exportmi.py src/exportmi.py
COPY src/languages.py src/languages.py
COPY data/example-config.py data/example-config.py

RUN chmod +x /Upload-Assistant/ptcli.py && \
    ln -sf /Upload-Assistant/ptcli.py /usr/local/bin/ptcli && \
    mkdir -p /Upload-Assistant/data/cookies /Upload-Assistant/tmp && \
    chmod 777 /Upload-Assistant/tmp

ENTRYPOINT ["python", "/Upload-Assistant/ptcli.py"]
