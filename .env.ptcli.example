# Copy this file to .env before running docker compose, then adjust values.

# Strongly recommended when ptcli-api is exposed outside localhost.
PTCLI_API_TOKEN=change-me

# External URL that OpenClaw/Hermes or reverse proxies should call.
PTCLI_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Keep the default unless you want to attach ptcli-api to an existing network.
PTCLI_DOCKER_NETWORK=upload-assistant-ptcli

# Container timezone.
TZ=Asia/Shanghai

# Optional: daily candidate schedule definitions used by /v1/candidates/daily/schedule.
# This only plans candidate jobs; external cron/AI still POSTs each job_request to /v1/jobs/candidates/daily.
PTCLI_DAILY_CANDIDATE_SCHEDULES=[{"name":"u2-to-mteam","source_tracker":"U2","target":"MTEAM","limit":10,"time":"09:00","timezone":"Asia/Shanghai","accept_rules":true}]
